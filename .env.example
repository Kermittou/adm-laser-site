# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.adm-laser.fr

# Envoi des formulaires par mail (SMTP). Sans ces valeurs, le formulaire affiche
# un message de repli avec le mail et le téléphone d'ADM.
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=commandes@adm-laser.fr
# Mot de passe de la boîte (secret). Un « $ » s'écrit « \$ ».
SMTP_PASS=
# Expéditeur et destinataire (par défaut : SMTP_USER → contact@adm-laser.fr)
MAIL_FROM='"ADM Laser" <commandes@adm-laser.fr>'
MAIL_TO=

# Paiement en ligne (Stripe). En développement : clés de TEST uniquement (sk_test_…).
# Sans clé, le bouton « Commander » renvoie vers « Demander ce devis ».
STRIPE_SECRET_KEY=
# Secret du webhook (tableau de bord Stripe → Webhooks → endpoint /api/stripe/webhook,
# événements checkout.session.completed, payment_intent.succeeded, payment_intent.canceled).
# En local, n'importe quelle valeur « whsec_local_… » suffit pour `npm run webhook:rejouer`.
STRIPE_WEBHOOK_SECRET=
# Adresse qui reçoit les commandes à préparer (DXF et bordereaux joints). Par défaut : commandes@adm-laser.fr
MAIL_COMMANDES=

# Boxtal (bordereaux Colissimo). Clés d'une application « API v3 » créée sur developer.boxtal.com.
# Clés de TEST → serveur de test https://api.boxtal.build ; clés de production → https://api.boxtal.com
BOXTAL_ACCESS_KEY=
BOXTAL_SECRET_KEY=
BOXTAL_API_URL=https://api.boxtal.build
